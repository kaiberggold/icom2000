#include "icom/audio/audio_engine.hpp"
#include "icom/config/station_registry.hpp"
#include "icom/core/logger.hpp"

#include <utility>
#include <vector>

namespace icom::audio {

namespace {

core::Logger& log = core::getLogger("audio");

class NullEngine final : public Engine {
public:
    explicit NullEngine(std::vector<config::Station> stations) : stations_(std::move(stations)) {}

    void start() override {
        // Named devices are already sitting in `stations_`, ready for a
        // real ALSA implementation to open them by name -- logged here
        // mainly so that fact is visible/testable before one exists.
        for (const auto& station : stations_) {
            log.debug("station \"" + station.name + "\" would open capture=" + station.captureDevice +
                       ", playback=" + station.playbackDevice);
        }
        log.warn("NullAudioEngine::start() -- no audio path implemented yet");
        running_ = true;
    }

    void stop() override { running_ = false; }

    bool isRunning() const override { return running_; }

private:
    std::vector<config::Station> stations_;
    bool running_ = false;
};

} // namespace

std::unique_ptr<Engine> makeNullEngine(const config::StationRegistry& stations) {
    return std::make_unique<NullEngine>(stations.all());
}

} // namespace icom::audio
